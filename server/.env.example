# Шаблон настроек сервера Satti (этап 3, задача 3.7). Скопируйте в файл .env и заполните.
#
# Приложение само .env не читает. Его нужно экспортировать до запуска, например:
#   Linux:   set -a; . ./.env; set +a; uvicorn app.main:app
#   Windows: переменные задаются в окружении запуска (PowerShell: $env:NAME = "значение").
#
# Секреты (ключи, пароли, пароли шифрования) в репозиторий не коммитить. Значения ниже — пример, не рабочие.

# ---------- Режим и база ----------
SATTI_ENV=development                 # production — включает проверки безопасной конфигурации при запуске
DATABASE_URL=sqlite:///./data/satti.db  # в продакшене: postgresql+psycopg://пользователь:пароль@хост:5432/satti
SATTI_DATA_DIR=./data                 # папка секрета сервера (secret_key) и данных
SATTI_OWNER_NAME=                      # имя оператора в юридических текстах (до регистрации ИП: как сейчас в документах)
SATTI_SUPPORT_EMAIL=satti.support@gmail.com  # адрес поддержки (страница /support, тексты магазинов)
SATTI_PUBLIC_BASE_URL=                # публичный адрес сайта, https://... (политика и условия: /privacy, /terms)
SATTI_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081  # в продакшене не должно содержать localhost
SATTI_TRUSTED_PROXIES=                # адреса прокси через запятую (Caddy); без них адрес клиента берётся напрямую

# ---------- Секреты (обязательны в продакшене) ----------
SATTI_BILLING_PEPPER=                 # соль для отметки пробного периода (хеши аккаунта, телефона, магазина Kaspi)
SATTI_TOTP_KEY=                       # ключ шифрования секрета 2FA администратора (Fernet, 32 байта base64)
SATTI_KASPI_KEY=                      # ключ шифрования токенов Kaspi (Fernet, 32 байта base64); нужен, если KASPI_ENABLED=1
SATTI_BACKUP_KEY=                     # ключ шифрования резервных копий (обязателен для scripts/backup.py)

# ---------- Вход ----------
SATTI_EMAIL_LOGIN=0                   # вход по коду на почту: только для разработки; в продакшене 0
SATTI_GOOGLE_CLIENT_IDS=              # идентификаторы клиентов Google через запятую (вход через Google)
SATTI_APPLE_CLIENT_ID=kz.satti.seller # идентификатор приложения для входа через Apple (bundle ID)
SATTI_ADMIN_EMAIL=                    # почта администратора (первый вход в админ-панель)

# ---------- Подписка и пробный период ----------
SATTI_BILLING_ENFORCED=0              # 1 — блокировать магазины без подписки (в продакшене 1 или SATTI_FREE_ACCESS=1)
SATTI_FREE_ACCESS=0                   # 1 — бесплатная бета без блокировки подписки
SATTI_BILLING_TEST_MODE=0             # 1 — пробный период без магазина приложений; в продакшене 0

# ---------- Демо-режим (ADR-0005) ----------
SATTI_DEMO_NEW_PER_IP_PER_HOUR=20     # новых демо-сессий с одного адреса в час
SATTI_DEMO_MAX=5000                   # всего демо-установок одновременно

# ---------- Kaspi (этап 2; выключено до письменного разрешения Kaspi) ----------
KASPI_ENABLED=0                       # 1 — подключение Kaspi (также нужен флаг kaspi_connection в админке)

# ---------- Фоновые задачи ----------
SATTI_SCHEDULER=0                     # 1 — ежедневные письма о хранении, удаление на 90-й день, синхронизация Kaspi
SATTI_OUTBOX_DIR=                     # папка писем в режиме outbox (по умолчанию внутри SATTI_DATA_DIR)

# ---------- ИИ-помощник (этап 3.5; ключ провайдера ещё не подключён) ----------
SATTI_AI_BUDGET_MONTHLY_USD=20        # месячный бюджет ИИ; при 80% и 100% — письмо владельцу (1.4)
SATTI_AI_COST_PER_CALL_USD=0          # стоимость одного вызова модели для учёта бюджета

# ---------- Почта (этап 3.6; SMTP ещё не подключён) ----------
# SATTI_SMTP_HOST=
# SATTI_SMTP_PORT=587
# SATTI_SMTP_USER=
# SATTI_SMTP_PASSWORD=
# SATTI_SMTP_FROM=Satti Seller <no-reply@example.invalid>
# SATTI_OWNER_ALERT_EMAIL=            # адрес владельца для оповещений о бюджете ИИ (1.4)

# ---------- Резервные копии (scripts/backup.py; задача 1.10) ----------
SATTI_BACKUP_DIR=./backups
SATTI_BACKUP_KEEP_DAYS=14
SATTI_PG_BIN=                         # папка с pg_dump и pg_restore, если их нет в PATH
SATTI_S3_BUCKET=                      # хранилище второй копии (необязательно)
SATTI_S3_ENDPOINT=                    # адрес S3-совместимого хранилища (необязательно)
SATTI_S3_ACCESS_KEY=
SATTI_S3_SECRET_KEY=
SATTI_S3_REGION=                      # необязательно

# ---------- Миграции ----------
SATTI_ALLOW_DOWNGRADE=0               # 1 — разрешить откат миграций (только вручную, с бэкапом)

# ---------- Тесты (не нужны для работы сервера) ----------
# SATTI_TEST_DATABASE_URL=postgresql+psycopg://postgres:пароль@127.0.0.1:5432/satti_test
