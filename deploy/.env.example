# Скопируйте в deploy/.env и заполните. Файл .env не коммитится (см. .gitignore). Права: chmod 600 deploy/.env
SATTI_DOMAIN=example.invalid            # домен сервера для HTTPS (A-запись должна вести на этот сервер)
POSTGRES_PASSWORD=                      # задайте длинный случайный пароль
SATTI_PUBLIC_BASE_URL=https://example.invalid
SATTI_BACKUP_KEY=                       # ключ шифрования копий: python scripts/backup.py genkey (хранить отдельно от копий!)
ANTHROPIC_API_KEY=                      # ключ ИИ-помощника; владелец вписывает сам
SATTI_AI_LIVE=1
SATTI_SUPPORT_EMAIL=
SATTI_OWNER_ALERT_EMAIL=
SATTI_ADMIN_EMAIL=
SATTI_APPLE_SIWA_KEY_ID=
SATTI_APPLE_SIWA_KEY_PATH=
SATTI_APPLE_TEAM_ID=
SATTI_PUSH_MODE=mock
SATTI_EXPO_ACCESS_TOKEN=
# второе хранилище копий — S3-совместимое у ДРУГОЙ казахстанской компании (К-23, docs/DR.md)
SATTI_S3_BUCKET=
SATTI_S3_ENDPOINT=
SATTI_S3_ACCESS_KEY=
SATTI_S3_SECRET_KEY=
SATTI_S3_REGION=
SATTI_BACKUP_DIR=/app/data/backups
SATTI_IP_REQUESTS_PER_MINUTE=300

# К-28: оператор — ИП. Что из этого публиковать в политике и условиях — решает юрист (legal-proposals п.12)
SATTI_OWNER_IIN=
SATTI_OWNER_CITY=
