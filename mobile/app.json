{
  "expo": {
    "name": "Satti Seller",
    "slug": "satti-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.satti.seller"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.satti.seller"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Satti Seller использует камеру, чтобы снять фото товара для описания. / Satti Seller тауар суретін описание үшін түсіру үшін камераны пайдаланады.",
          "photosPermission": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "satti",
    "experiments": {
      "typedRoutes": true
    }
  }
}
